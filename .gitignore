# Local environment, NASA caches and intermediate analysis
.venv/
venv/
data/
__pycache__/
*.py[cod]
.DS_Store
*.part
*.bak
.pytest_cache/

# Newly generated plots/candidate outputs stay local by default.
figures/*.png
figures/holdout_review/
results/*.csv
results/*.json

# Local execution logs
logs/

# Local editor settings and alternative Python virtual environments
.venv-*/
.vscode/
.idea/

# Never accidentally commit raw spacecraft science arrays outside data/
*.cdf
*.npz
*.cdf.gz
